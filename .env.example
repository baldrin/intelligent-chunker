# Required for the chunker (Pass 1 + Pass 2 call Claude Haiku).
ANTHROPIC_API_KEY=sk-ant-...

# --- Databricks routing (instead of the direct Anthropic API) ---
# Point the SDK at the workspace's native Anthropic Messages endpoint; the
# token is sent as a Bearer header. Use databricks-claude-* model names
# (--pass1-model / --pass2-model) and drop the request budget to fit the
# ~4 MB serving limit (--max-request-mb 3). Verify an endpoint first with
# databricks_smoke_test.py (must run inside the tenant).
# ANTHROPIC_BASE_URL=https://<workspace-host>/serving-endpoints/anthropic
# ANTHROPIC_AUTH_TOKEN=dapi...
# If the endpoint presents a private/corporate CA, name the PEM bundle to
# trust (or `pip install truststore` to use the OS certificate store):
# CHUNKER_CA_BUNDLE=/path/to/corp-ca.pem
# The GTE tokenizer downloads from huggingface.co through its own HTTP stack,
# which that bundle does not cover. If the download fails (SSL error / no
# egress), fetch this file once and point at it (or use --tokenizer):
#   https://huggingface.co/Alibaba-NLP/gte-large-en-v1.5/resolve/main/tokenizer.json
# CHUNKER_TOKENIZER=/path/to/gte-tokenizer.json

# Optional, used only by the embedding phase (not wired yet).
# GTE_ENDPOINT_URL=http://localhost:8080/embed
